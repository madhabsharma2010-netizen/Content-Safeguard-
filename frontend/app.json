{
  "expo": {
    "name": "Content Safeguard Ultra",
    "slug": "content-safeguard-ultra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.contentsafeguard.ultra",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.contentsafeguard.ultra",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Content Safeguard to access your photos for content analysis.",
          "cameraPermission": "Allow Content Safeguard to access your camera for content analysis."
        }
      ]
    ],
    "scheme": "content-safeguard-ultra",
    "description": "Ultra-Accurate AI-Powered Content Monitoring & Filtering System. Protect yourself from fake news, inappropriate content, and harmful material across all social media platforms with 95%+ accuracy.",
    "githubUrl": "https://github.com/your-username/content-safeguard-ultra"
  }
}
